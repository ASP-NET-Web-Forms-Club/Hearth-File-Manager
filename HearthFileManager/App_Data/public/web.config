<?xml version="1.0" encoding="utf-8"?>
<!--
  Public website managed by Hearth File Manager.
  Second guard for the private App_Data folder (SQLite databases): IIS already hides "App_Data"
  and does not serve unknown file types such as .db by default; these rules keep it that way even
  if the server defaults are changed. Keep them when editing this file.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <remove value="index.php" />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="App_Data" />
          <add segment="App_Data" />
        </hiddenSegments>
        <fileExtensions>
          <remove fileExtension=".db" />
          <add fileExtension=".db" allowed="false" />
          <remove fileExtension=".sqlite" />
          <add fileExtension=".sqlite" allowed="false" />
          <remove fileExtension=".sqlite3" />
          <add fileExtension=".sqlite3" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
