# Visual Studio / build output
.vs/
bin/
obj/
packages/
*.user
*.suo

# ---------------------------------------------------------------------------
# App_Data: commit only the skeleton, never runtime data.
#   kept:    config.sample.json, readme.txt, public/web.config, public/App_Data/.gitkeep
#   ignored: config.json (API key, password hashes), sessions, recycle bin, undo, tmp,
#            and every website file / database inside public/
# ---------------------------------------------------------------------------
HearthFileManager/App_Data/*
!HearthFileManager/App_Data/config.sample.json
!HearthFileManager/App_Data/readme.txt
!HearthFileManager/App_Data/public/

HearthFileManager/App_Data/public/*
!HearthFileManager/App_Data/public/web.config
!HearthFileManager/App_Data/public/App_Data/

HearthFileManager/App_Data/public/App_Data/*
!HearthFileManager/App_Data/public/App_Data/.gitkeep

# PowerShell test sandbox
tests/sandbox/
